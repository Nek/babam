(use '[huff2.core :as h2])

(defn component [_ _]
(h2/html [:div "Hello"]))

(def title "Your Page Title")
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
    <header>
        <h1>{{(+ 1 2)}}</h1>
    </header>
    <c:component>1 2 3</c:component>
    <main>
        <p>This is a basic HTML5 template.</p>
    </main>
    <footer>
        <p>&copy; 2025 Your Name</p>
    </footer>
</body>
</html>
